APP_NAME=KITsuluh
APP_ENV=production
APP_KEY=base64:v+87HGve2IcC2R2R2/biPsvVFE6dWIM0HjaAnoJoOGg=
APP_DEBUG=false
APP_URL=https://kitsuluh.krakatau-it.co.id
APP_DOMAIN=kitsuluh.krakatau-it.co.id
APP_IMAGE_TAG=latest

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kitsuluh
DB_USERNAME=kitsuluh
DB_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=kitsuluh.krakatau-it.co.id
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@kitsuluh.krakatau-it.co.id
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CORS_ALLOWED_ORIGINS=https://kitsuluh.krakatau-it.co.id
SANCTUM_STATEFUL_DOMAINS=kitsuluh.krakatau-it.co.id

TRAEFIK_NETWORK=web
TRAEFIK_HTTP_ENTRYPOINT=web

VITE_APP_NAME="${APP_NAME}"
